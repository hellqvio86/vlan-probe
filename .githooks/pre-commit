#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

# Baseline security scans (TruffleHog & Trivy)
if [[ -d "${HOME}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi

echo "--> Running TruffleHog secret scan..."
if command -v trufflehog >/dev/null 2>&1; then
    git diff --cached | trufflehog --no-update stdin --only-verified --fail
    trufflehog --no-update git file://"$REPO_ROOT" --only-verified --fail
elif command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$REPO_ROOT":/src -w /src trufflesecurity/trufflehog:latest git file:///src --only-verified --fail
else
    echo "ERROR: trufflehog or docker is required for pre-commit checks!" >&2
    exit 1
fi

echo "--> Running Trivy vulnerability scan..."
if command -v trivy >/dev/null 2>&1; then
    trivy fs --severity HIGH,CRITICAL --exit-code 1 .
elif command -v docker >/dev/null 2>&1; then
    docker run --rm -v "$REPO_ROOT":/src -v trivy-cache:/root/.cache -w /src aquasec/trivy:latest fs --severity HIGH,CRITICAL --exit-code 1 .
else
    echo "ERROR: trivy or docker is required for pre-commit checks!" >&2
    exit 1
fi


echo "==> Running git pre-commit checks..."

# Ensure local user paths are available for uv / tools
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

if command -v uv >/dev/null 2>&1; then
    RUN_CMD="uv run"
elif [ -d ".venv" ]; then
    RUN_CMD=".venv/bin"
else
    echo "Error: Neither 'uv' nor local '.venv' found. Please install uv." >&2
    exit 1
fi

if command -v uv >/dev/null 2>&1; then
    echo "--> Checking uv lockfile consistency..."
    uv lock --check
fi

echo "--> Checking ruff lint..."
$RUN_CMD ruff check .

echo "--> Checking ruff format..."
$RUN_CMD ruff format --check .

echo "--> Checking mypy typing (src/)..."
$RUN_CMD mypy src

echo "--> Running pytest..."
$RUN_CMD pytest

echo "==> All pre-commit checks passed successfully!"
